              "host": ["{{base_url}}"],
              "path": ["api", "attendance", "admin", "all"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Admin View Employee Attendance",
          "request": {
